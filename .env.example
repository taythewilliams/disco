# Copy to .env and fill in. .env is gitignored — no secret belongs in source (D12).
# Load it with Node's own flag; there is no dotenv dependency:
#   node --env-file=.env --import tsx packages/server/src/main.ts

# Unprivileged port. Caddy owns 443 and reverse-proxies here, so this process
# never needs root and never handles a certificate.
DISCO_PORT=3000

# Loopback by default. Only widen this if you are running without Caddy.
DISCO_HOST=127.0.0.1

# The public hostname guests type, used by the ops scripts:
#   npm run preflight -- --ip 192.168.4.10
#   npm run cert-check
# The A record for it points at the MacBook's static LAN address, DNS-only
# (grey cloud) in Cloudflare — a proxied record breaks silently (D14).
# DISCO_PUBLIC_HOST=party.example.com

# Where ingest wrote its output. Holds disco.db and tracks/.
DISCO_MEDIA_ROOT=media

# Which venue profile to load. Projector lag varies by unit and by room, so the
# offset measured at one venue is worthless at the next (D8). The profile also
# keeps prefetch depth, the device preset table, the moderation mode and saved
# crates — everything decided before doors that should still be there after a
# restart. Letters, digits, _ and - only: it becomes a filename.
DISCO_VENUE=default

# Where that profile lives. Defaults to media/venue-<venue>.json.
# DISCO_VENUE_FILE=media/venue-default.json

# Built apps, served by this process in production:
#   /            the guest PWA
#   /host/       the dashboard bundle's assets
#   /dj          the DJ dashboard
#   /display     the projector (D8)
# Leave these alone in development — Vite serves both on their own ports and
# proxies here, and a missing dist is normal rather than an error.
# DISCO_GUEST_DIR=apps/guest/dist
# DISCO_HOST_DIR=apps/host/dist

# Printed on the QR poster. Not a secret from guests — it is the door, not the safe.
DISCO_EVENT_CODE=change-me

# A real secret. Anyone holding this can control the music.
DISCO_DJ_PASSWORD=change-me-to-something-long

# Optional, 12+ characters. Gates the read-only projector role: it reads the
# timeline and the moderated feed and can change nothing. Leave it unset for an
# event with no projector — then no display session can be created at all.
# DISCO_DISPLAY_CODE=change-me-to-something-long

# HMAC key for session cookies, 32+ characters. Generate with:
#   openssl rand -hex 32
# Rotating it logs everyone out and nothing worse.
DISCO_SESSION_SECRET=change-me

# Optional: extra comment filter terms, one per line, # for comments.
# Keep this file out of the repository — the list that matters for a given
# crowd is not something to commit.
# DISCO_WORDLIST_FILE=./wordlist.txt

# Per-IP cap on session attempts, guarding the event code against guessing.
# Default 20. Raise it only to run the virtual-client harness, which opens many
# sessions from one address on purpose:
#   npm run harness -- --clients 30 --stagger 0 --seconds 60
# DISCO_JOIN_ATTEMPTS_PER_MINUTE=400

# Development only. Leave unset in the venue: a session cookie without the
# Secure flag is a session cookie readable on the venue Wi-Fi.
# DISCO_INSECURE_COOKIES=1
