# Caddy on the venue MacBook (D14, Spike 4).
#
# Copy to ops/Caddyfile, set the hostname, and run:
#
#   sudo caddy run --config ops/Caddyfile
#
# `sudo` because 443 is a privileged port and macOS has no capabilities to hand
# it to a normal user. Only Caddy runs elevated; the Node app stays a normal
# user on a high port, which is the property D12 actually asks for.
#
# ── Why DNS-01 ──────────────────────────────────────────────────────────────
#
# HTTP-01 proves ownership by serving a file over the public internet. This
# server has no public reachability: the A record points at a private address on
# the venue LAN. DNS-01 proves ownership with a temporary TXT record instead.
#
# Self-signed is not an alternative. Service workers refuse to register on an
# origin with a certificate error even after the user clicks through, and no
# service worker means no PWA install, no offline shell and no persistent
# storage (D14, D15).
#
# ── Two ways to get the certificate ─────────────────────────────────────────
#
# **Manual issuance (the current choice).** The zone lives in cPanel on shared
# hosting, whose DNS has no Caddy provider module, and the domain carries live
# mail — moving the zone to get one certificate would put the mail records in
# the path of a party. So the TXT record is added by hand and Caddy is handed
# the resulting files. See `docs/spikes/04-https-lan.md` for the procedure and
# `ops/scripts/renew-cert.sh` for the command.
#
# The cost is honest: renewal is a manual step before every event, which is why
# `npm run cert-check` is on the pre-event checklist rather than a nicety.
#
# **Automated issuance**, if the zone ever moves to a provider with a module
# (Cloudflare, deSEC, Route53, …): drop the `tls` line below for this block,
# and build Caddy with the module — stock Caddy has no DNS providers compiled
# in:
#
#   brew install xcaddy
#   xcaddy build --with github.com/caddy-dns/cloudflare
#   caddy list-modules | grep dns.providers
#
#   tls {
#       dns cloudflare {env.CLOUDFLARE_API_TOKEN}
#       resolvers 1.1.1.1 1.0.0.1
#   }
#
# A token in that form is read from the environment and never written here:
# this file is in the repository, and a DNS token in source control is a DNS
# token on GitHub (D12).
{
	# Where the account key and certificates live. Kept next to the config so
	# "did it renew?" is answerable by looking at one directory, and so a laptop
	# rebuild does not silently lose the account.
	storage file_system {
		root ./ops/caddy-data
	}

	# Nothing here issues certificates: the `tls` line below points at files
	# certbot already wrote. Kept so that switching to automated issuance later
	# is one uncommented line rather than a rewrite.
	email you@example.com
}

# Replace with the real hostname. The public A record for it points at the
# MacBook's LAN address — unusual but valid, and standard for this situation
# (D14 step 2).
party.example.com {
	# Certificate and key from the manual DNS-01 run. certbot writes symlinks
	# here that move on each renewal; Caddy follows them, so the paths do not
	# change from event to event.
	#
	# Absolute paths, and no `~`: Caddy runs under sudo, whose home is not
	# yours, and a relative path would resolve against whatever directory it
	# was started from.
	tls /Users/you/.disco-certs/config/live/party.example.com/fullchain.pem /Users/you/.disco-certs/config/live/party.example.com/privkey.pem

	encode zstd gzip

	# The app never handles TLS: Caddy terminates and proxies to the
	# unprivileged port Node listens on, so the Node process never needs root
	# to bind 443 (D12, D14 step 4).
	reverse_proxy 127.0.0.1:3000 {
		# The WebSocket carries clock sync; a proxy that gives up on an idle
		# socket would disconnect the room between tracks.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	header {
		# One event, one origin, no third-party anything. `connect-src` covers
		# the WebSocket; `media-src` covers the fMP4 segments.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# The projector and the dashboard are the only pages that would ever
		# want a camera or a microphone, and neither does. Mic access in
		# particular would switch iOS Bluetooth to the call profile and change
		# the audio latency of every guest who granted it (D1).
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# One night, not a year: a stale HSTS pin on a guest's phone outlives
		# the event and the domain's usefulness for it.
		Strict-Transport-Security "max-age=86400"
		-Server
	}

	# To stdout, not to a file in the repository. Caddy runs under sudo, and a
	# root-owned log file inside the working tree is a small trap: every later
	# `caddy validate` as your own user fails on it. Redirect if you want a
	# file.
	#
	# Connection events, not payloads. Comment text must never reach a log —
	# it is ephemeral by decision (D7, D12).
	log {
		format console
	}
}
